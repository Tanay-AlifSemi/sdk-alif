/*
 * Copyright (C) 2026 Alif Semiconductor - All Rights Reserved.
 *
 * DevKit-E8 onboard eMMC in 8-bit mode. Same mapping as the
 * alif-emmc-8bit snippet: D0-D3/CMD/CLK stay on the board pinctrl
 * (pad 0x23); this overlay adds D4-D7 on P8_4-P8_7 (pad 0x41).
 */

ns: &ns {
	status = "okay";
};

&gpio14 {
	status = "okay";
};

&pinctrl_sdmmc {
	/* D4-D7 on P8_4-P8_7 SD_Dx_C (not P5_4-P5_7). Linux pad 0x41 */
	group1 {
		pinmux = < PIN_P8_4__SD_D4_C >,
			 < PIN_P8_5__SD_D5_C >,
			 < PIN_P8_6__SD_D6_C >,
			 < PIN_P8_7__SD_D7_C >;
		read-enable = <0x1>;
		schmitt-enable = <0x0>;
		drive-strength = <8>;
	};
};

sdhc: &sdhc {
	status = "okay";
	/delete-property/ cd-gpios;
	bus-width = <8>;
	/* 8-bit: 400 kHz, 3.3 V (SDHCI div 250). */
	no-1-8-v;
	max-bus-freq = <400000>;

	mmc {
		compatible = "zephyr,mmc-disk";
		disk-name = "SD2";
		bus-width = <8>;
		status = "okay";
	};
};
